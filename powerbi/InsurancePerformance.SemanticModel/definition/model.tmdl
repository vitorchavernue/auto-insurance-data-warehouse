model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

annotation PBI_QueryOrder = ["DataFolder", "Date", "Coverage", "Product", "Broker", "Geography", "Vehicle Profile", "Earned Premium", "Written Premium", "Claim Movements", "Claims", "Renewals"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Date
ref table Coverage
ref table Product
ref table Broker
ref table Geography
ref table 'Vehicle Profile'
ref table 'Earned Premium'
ref table 'Written Premium'
ref table 'Claim Movements'
ref table Claims
ref table Renewals

